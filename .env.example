# Select local, qa, staging, or production. Do not use production for destructive tests.
TEST_ENV=qa

# Application-specific placeholders: provide approved non-production endpoints.
BASE_URL=https://eventhub.rahulshettyacademy.com
API_BASE_URL=
APP_LOGIN_PATH=

# Application-approved Playwright selectors. No application selectors are assumed.
LOGIN_USERNAME_SELECTOR=karun4242@gmail.com
LOGIN_PASSWORD_SELECTOR=Karun@123
LOGIN_SUBMIT_SELECTOR=
LOGIN_SUCCESS_SELECTOR=
LOGIN_ERROR_SELECTOR=

# Browser settings
BROWSER=chromium
HEADLESS=true
PLAYWRIGHT_HEADED=false
DEFAULT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
API_TIMEOUT_MS=30000

# Dedicated test-account credentials only. Keep real values in an untracked .env file.
TEST_USERNAME=karun4242@gmail.com
TEST_PASSWORD=Karun@123
TEST_INVALID_PASSWORD=Invalid@123

# EventHub event booking scenario data. Use dedicated test data.
EVENT_CITY=Guntur
EVENT_VENUE=Test Venue
EVENT_DESCRIPTION=Test event for booking
TEST_CUSTOMER_NAME=John Doe
TEST_CUSTOMER_EMAIL=john.doe@example.com
TEST_CUSTOMER_PHONE=123-456-7890

# Cucumber worker count; 0 disables parallel execution.
CUCUMBER_PARALLEL=0
