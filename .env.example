# Select local, qa, staging, or production. Event creation is blocked in production.
TEST_ENV=qa

# Application-specific placeholders: replace with approved non-production endpoints.
BASE_URL=https://your-qa-app.example.test
API_BASE_URL=
APP_LOGIN_PATH=

# Application-approved Playwright selectors.
LOGIN_USERNAME_SELECTOR=
LOGIN_PASSWORD_SELECTOR=
LOGIN_SUBMIT_SELECTOR=
LOGIN_SUCCESS_SELECTOR=
LOGIN_ERROR_SELECTOR=

# Browser settings
BROWSER=chromium
HEADLESS=true
PLAYWRIGHT_HEADED=false
DEFAULT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
API_TIMEOUT_MS=30000

# Dedicated test-account credentials only. Keep real values in an untracked .env file.
TEST_USERNAME=your-test-username
TEST_PASSWORD=your-test-password
TEST_INVALID_PASSWORD=your-invalid-test-password

# EventHub event booking scenario data. Use dedicated test data.
EVENT_CITY=your-test-city
EVENT_VENUE=your-test-venue
EVENT_DESCRIPTION=Automated test event
TEST_CUSTOMER_NAME=Test Customer
TEST_CUSTOMER_EMAIL=test-customer@example.test
TEST_CUSTOMER_PHONE=0000000000

# Cucumber worker count; 0 disables parallel execution.
CUCUMBER_PARALLEL=0
